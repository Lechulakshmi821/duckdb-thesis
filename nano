set datafile separator comma
set style data histograms
set style histogram cluster gap 1
set style fill solid 0.7 border -1
set boxwidth 0.9
set grid ytics
set ylabel "Runtime (ms)"
set terminal pngcairo size 800,500

# ---------- 2 vars, 100k tuples, 1 thread ----------
set title "2 variables, 100k tuples, 1 thread"
set output "bar_2vars_100k_t1.png"
plot \
  "< awk -F, '$1==2 && $2==100000 && $3==1 {print $4,$5}' results.csv" \
  using 2:xtic(1) title ""

# ---------- 3 vars, 100k tuples, 1 thread ----------
